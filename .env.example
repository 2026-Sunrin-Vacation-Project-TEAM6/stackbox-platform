# Copy this file to .env and fill in real values before running docker compose.
# .env is gitignored; never commit real secrets.

# --- Postgres (db service) ---
POSTGRES_USER=stackbox
POSTGRES_PASSWORD=stackbox
POSTGRES_DB=stackbox_db

# --- Shared across backend + web_worker ---
# Must be identical for both services, or tokens issued by backend
# will fail verification in web_worker's WebSocket handshake.
JWT_SECRET=change-me
JWT_ALGORITHM=HS256

REDIS_STREAM_PREFIX=stackbox:events

# --- backend (Elixir / Phoenix) ---
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=
# Host the Phoenix endpoint answers for (used to build the :url config).
PHX_HOST=localhost
POOL_SIZE=10
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Named BACKEND_* (not OPENAI_*) on purpose: many shells/CLI tools (incl.
# Claude Code provider proxies) export OPENAI_API_KEY/OPENAI_MODEL/OPENAI_BASE_URL
# themselves, and those shell vars would silently override this .env file
# when docker compose resolves ${VAR} substitutions.
BACKEND_OPENAI_API_KEY=
# Leave blank to use OpenAI's default endpoint automatically.
BACKEND_OPENAI_BASE_URL=
BACKEND_OPENAI_MODEL=gpt-4o-mini

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://localhost/api/github/oauth/callback

TOKEN_ENCRYPTION_KEY=

FRONTEND_BASE_URL=https://localhost

# Comma-separated list of origins allowed by backend CORS. Append
# https://${DOMAIN} here once a real domain exists.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002,https://localhost

# --- nginx / Let's Encrypt ---
# Placeholder until a real domain exists. Once DNS points at this host, set
# the real values below (including the URLs above/below that reference
# "localhost") and run ./nginx/init-letsencrypt.sh once.
DOMAIN=example.com
CERTBOT_EMAIL=admin@example.com

# Browser-facing URLs (frontend service), reached through nginx. All
# service ports are only exposed via nginx now, not directly on the host
# -- run ./nginx/init-letsencrypt.sh before the first `docker compose up`
# so nginx has a cert to start with (self-signed until DOMAIN is real).
#
# NEXT_PUBLIC_WORKER_URL must point at nginx's `/worker/` location: the
# client appends `/ws/{stackBoxId}` to this base, and only `<host>/worker/ws/...`
# is proxied to web_worker (see nginx/nginx.conf). `.../ws` alone would fall
# through to the frontend's `location /` and never reach the relay.
NEXT_PUBLIC_API_URL=https://localhost/api
NEXT_PUBLIC_WORKER_URL=wss://localhost/worker

# --- web_worker (realtime relay) ---
REDIS_STREAM_GROUP=web_worker
REDIS_STREAM_CONSUMER=worker-1

# --- frontend (Next.js) ---
# NEXT_PUBLIC_API_URL / NEXT_PUBLIC_WORKER_URL are baked into the JS bundle at
# build time (docker compose build args, see frontend service), so the frontend
# image must be rebuilt whenever they change. They are defined once above —
# do not redefine them here with direct localhost ports, or the later value
# wins and bypasses nginx (web_worker is not reachable from the browser anyway).

# --- code_runner ---
CODE_RUNNER_HOST=0.0.0.0
CODE_RUNNER_PORT=3001
# Shared secret backend must send as the X-Code-Runner-Token header on
# every /execute call; code_runner refuses to start without this set.
CODE_RUNNER_AUTH_TOKEN=change-me
