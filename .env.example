# Copy this file to .env and fill in real values before running docker compose.
# .env is gitignored; never commit real secrets.

# --- Postgres (db service) ---
POSTGRES_USER=stackbox
POSTGRES_PASSWORD=stackbox
POSTGRES_DB=stackbox_db

# --- Shared across backend + web_worker ---
# Must be identical for both services, or tokens issued by backend
# will fail verification in web_worker's WebSocket handshake.
JWT_SECRET=change-me
JWT_ALGORITHM=HS256

REDIS_STREAM_PREFIX=stackbox:events

# --- backend (FastAPI) ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Named BACKEND_* (not OPENAI_*) on purpose: many shells/CLI tools (incl.
# Claude Code provider proxies) export OPENAI_API_KEY/OPENAI_MODEL/OPENAI_BASE_URL
# themselves, and those shell vars would silently override this .env file
# when docker compose resolves ${VAR} substitutions.
BACKEND_OPENAI_API_KEY=
# Leave blank to use OpenAI's default endpoint automatically.
BACKEND_OPENAI_BASE_URL=
BACKEND_OPENAI_MODEL=gpt-4o-mini

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/github/oauth/callback

TOKEN_ENCRYPTION_KEY=

FRONTEND_BASE_URL=http://localhost:3000

# --- web_worker (realtime relay) ---
REDIS_STREAM_GROUP=web_worker
REDIS_STREAM_CONSUMER=worker-1

# --- code_runner ---
CODE_RUNNER_HOST=0.0.0.0
CODE_RUNNER_PORT=3001
# Shared secret backend must send as the X-Code-Runner-Token header on
# every /execute call; code_runner refuses to start without this set.
CODE_RUNNER_AUTH_TOKEN=change-me
